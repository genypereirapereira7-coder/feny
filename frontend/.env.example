VITE_API_BASE_URL=http://localhost:8000/api/v1

# Opcional, só em dev: login automático sem passar pela tela de login, só
# nesta máquina. Deixe em branco pra pedir usuário/senha normalmente (a tela
# de login é o padrão pra qualquer um sem esta variável configurada).
#
# NUNCA configure isto nas Variables do serviço no Railway: o Vite embute
# estas variáveis em texto puro no JS que vai pro navegador de qualquer
# visitante. Sem elas (build de produção não tem acesso a este `.env`), o
# Vite remove esse código inteiro do bundle — não é um risco se você nunca
# configurar isto fora da sua máquina.
VITE_AUTO_LOGIN_USERNAME=
VITE_AUTO_LOGIN_PASSWORD=
