VITE_API_BASE_URL=http://localhost:8000/api/v1

# Opcional, só em dev: login automático sem passar pela tela de login.
# Deixe em branco pra pedir usuário/senha normalmente.
#
# NUNCA configure isto em Railway/produção: o Vite embute estas variáveis em
# texto puro no JS que vai pro navegador de qualquer visitante — e a tela de
# login está desligada agora (ver ProtectedRoute.tsx), então sem ela e sem
# estas variáveis o site fica travado em "não foi possível entrar
# automaticamente" pra qualquer pessoa real. Religue a tela de login antes
# de publicar isto pra alguém além de você.
VITE_AUTO_LOGIN_USERNAME=
VITE_AUTO_LOGIN_PASSWORD=
