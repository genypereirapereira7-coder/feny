# Copie para .env e ajuste. O .env não vai pro git (ARCHITECTURE.md §13).

DJANGO_SETTINGS_MODULE=config.settings.dev

# Em produção gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-inseguro-troque-em-producao

DATABASE_URL=postgres://localhost:5432/feny_dev

# Só usados em staging/production (config/settings/staging.py e production.py).
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Mercado Pago (Fase 6). Sem token, `issue_charge` recusa com erro de domínio
# claro — cobrança continua funcionando manualmente (Fase 5).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
MERCADOPAGO_WEBHOOK_SECRET=

# Evolution API / WhatsApp (Fase 7). Sem isso, notificações ficam PENDING e
# `dispatch_notifications` marca como falha até configurar.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=

# Sentry (Fase 10, opcional — só usado em produção). Sem DSN, roda sem
# rastreamento de erro nenhum.
SENTRY_DSN=
